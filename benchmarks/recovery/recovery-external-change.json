{
  "id": "recovery-external-change",
  "domain": "recovery",
  "fixture": "audit_sandbox",
  "steps": [
    {
      "type": "prompt",
      "text": "读取 state.txt 并记住当前内容，不要修改文件。"
    },
    {
      "type": "modify_file",
      "path": "state.txt",
      "content": "externally changed\n"
    },
    {
      "type": "inspect"
    },
    {
      "type": "restart"
    },
    {
      "type": "prompt",
      "text": "重新读取 state.txt，报告它现在的内容。"
    }
  ],
  "budgets": {
    "timeout_seconds": 120,
    "max_tool_calls": 8
  },
  "assertions": [
    {
      "type": "run",
      "dimension": "recovery",
      "expect_freshness": "stale"
    },
    {
      "type": "context",
      "dimension": "recovery",
      "expect_stale_item": "state.txt"
    }
  ]
}
