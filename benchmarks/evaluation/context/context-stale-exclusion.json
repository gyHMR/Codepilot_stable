{
  "id": "context-stale-exclusion",
  "domain": "context",
  "fixture": "audit_sandbox",
  "steps": [
    {
      "type": "prompt",
      "text": "读取 state.txt 并记住当前内容，不要修改文件。"
    },
    {
      "type": "modify_file",
      "path": "state.txt",
      "content": "updated-state"
    },
    {
      "type": "prompt",
      "text": "重新确认 state.txt 的最新内容，不要使用已经过期的旧读取结果。"
    }
  ],
  "metrics": [
    "context.key_context_hit_rate",
    "context.stale_context_rate"
  ],
  "expected": {
    "key_context": [
      "state.txt"
    ]
  },
  "budgets": {
    "timeout_seconds": 120,
    "max_tool_calls": 8
  },
  "assertions": [
    {
      "type": "run",
      "expect_status": "completed"
    }
  ]
}
