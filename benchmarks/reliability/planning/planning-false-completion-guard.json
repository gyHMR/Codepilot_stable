{
  "id": "planning-false-completion-guard",
  "domain": "planning",
  "fixture": "calculator",
  "prompt": "修复 calculator.py 中 divide() 的除零行为：除数为 0 时抛出 ValueError。完成前必须运行测试，并且最终回答要说明测试结果。",
  "budgets": {
    "timeout_seconds": 120,
    "max_tool_calls": 12,
    "max_replans": 2
  },
  "assertions": [
    {
      "type": "command",
      "command": "python -m pytest -q",
      "expect_exit_code": 0
    },
    {
      "type": "task",
      "expect_completion_satisfied": true,
      "require_evidence_refs": true,
      "forbid_false_completion": true
    },
    {
      "type": "diff",
      "allowed_paths": ["calculator.py"],
      "forbidden_paths": ["test/"]
    }
  ]
}
