# Codepilot 鐜鍙橀噺妯℃澘锛圵indows PowerShell锛?
# 澶嶅埗涓?.env.ps1 鍚庡～鍏ョ湡瀹炲€?

# 椋炰功搴旂敤鍑嵁
$env:FEISHU_APP_ID       = "cli_xxxxxxxxxxxx"
$env:FEISHU_APP_SECRET   = "your_app_secret_here"
$env:FEISHU_VERIFY_TOKEN = ""  # 鍙€?

# LLM API Key
$env:ANTHROPIC_API_KEY   = "your_anthropic_api_key_here"
$env:OPENAI_API_KEY      = ""  # 鍙€?

# 妯″瀷閰嶇疆锛堝彲閫夛紝瑕嗙洊榛樿鍊硷級
$env:CODEPILOT_PROVIDER   = "anthropic"
$env:CODEPILOT_MODEL_ID   = "glm-4.7"


